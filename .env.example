# Copy these into Vercel: Project > Settings > Environment Variables. Never commit real values.
ANTHROPIC_API_KEY=
RESEND_API_KEY=
# Sender must be on a domain you have verified in Resend, e.g. AP Studios <proposals@yourdomain.sg>
PROPOSAL_FROM=
# Where the copy of every proposal goes. Set this in Vercel to your own inbox (kept out of this public repo).
PROPOSAL_CC=
